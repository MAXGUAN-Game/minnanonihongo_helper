{
	admin off
}

{$APP_DOMAIN} {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		X-Frame-Options DENY
		Permissions-Policy "microphone=(self), camera=(), geolocation=()"
		-Server
	}

	# The application verifies persistent version-bound sessions; proxy and origin checks remain mandatory.
	route {
		reverse_proxy app:4317 {
			header_up -Authorization
			header_up X-Nihongo-Client-IP {http.request.remote.host}
			header_up X-Nihongo-Proxy {$APP_PROXY_TOKEN}
			transport http {
				dial_timeout 10s
				response_header_timeout 150s
			}
		}
	}
}
