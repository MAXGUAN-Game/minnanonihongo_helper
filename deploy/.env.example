APP_AUTH_USER=learner
APP_AUTH_HASH=
APP_PROXY_TOKEN=
APP_UID=1000
APP_GID=1000
ICP_NUMBER=
# Keep the generated bcrypt value in single quotes, so Compose preserves '$'.
# Configure DeepSeek and MiniMax later in the HTTPS application's settings.
