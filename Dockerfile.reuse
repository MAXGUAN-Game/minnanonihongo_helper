# The updater uses this only when dependency manifests match the running image.
ARG BASE_IMAGE
FROM ${BASE_IMAGE}
USER root
WORKDIR /app
COPY --chown=node:node package.json package-lock.json tsconfig.json vite.config.ts index.html weekly-plan.html ./
COPY --chown=node:node src ./src
COPY --chown=node:node public ./public
COPY --chown=node:node scripts/validate-vocabulary-details.ts scripts/check-progress-integrity.mjs scripts/check-release-auth.mjs ./scripts/
RUN npm run build
USER node
RUN node --import tsx --input-type=module -e "import { accessSync, constants } from 'node:fs'; accessSync('src/server/index.ts', constants.R_OK); await import('./src/server/app.ts');"
