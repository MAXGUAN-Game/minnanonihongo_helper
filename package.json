{
  "name": "nihongo-small-steps",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "node --use-env-proxy --import tsx src/server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node --import tsx scripts/check-browser.mjs",
    "setup:speech": "node scripts/setup-speech.mjs",
    "setup:speech:linux": "node scripts/setup-speech-linux.mjs",
    "package:web": "node scripts/package-web.mjs",
    "package:offline": "node scripts/package-offline.mjs",
    "launch": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start.ps1"
  },
  "dependencies": {
    "@fastify/static": "^10.1.5",
    "better-sqlite3": "13.0.3",
    "fastify": "^5.6.0",
    "lucide-react": "1.33.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.1.0",
    "tsx": "^4.21.0",
    "typescript": "6.0.3",
    "vite": "^8.0.0",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=24.5.0"
  }
}
